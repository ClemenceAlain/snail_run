<!--
  The snail, centred.

  An adaptive icon is 108 × 108 but only the middle survives: the launcher may crop it to
  a circle, a squircle or a rounded square, and everything outside a 66 dp circle centred
  on the canvas is at the mask's mercy. The previous drawing sat low and a shade left,
  which put the front of the foot and the antenna right on that boundary — hence a snail
  with its nose cut off on every round-icon launcher.

  So the whole animal is laid out inside a circle of radius 33 about (54, 54). The
  farthest point of it — the front of the foot — is at 32.3, which leaves it clear of the
  mask on any shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The foot, with the head raised at the left end. -->
    <path
        android:pathData="M32,63 h36 a4,4 0 0 1 0,8 h-40 a6,6 0 0 1 0,-12 h4 z"
        android:fillColor="#0A7C4F" />

    <!-- The shell, seated on the foot rather than hanging below it. Drawn over the foot,
         so the two read as one silhouette. -->
    <path
        android:pathData="M66,54 m-17,0 a17,17 0 1,1 34,0 a17,17 0 1,1 -34,0"
        android:fillColor="#0A7C4F" />
    <!-- Off-centre on purpose: a shell whorl is not concentric, and the offset is what
         stops the icon reading as a wheel. -->
    <path
        android:pathData="M63,52 m-8.5,0 a8.5,8.5 0 1,0 17,0 a8.5,8.5 0 1,0 -17,0"
        android:fillColor="#D9F2E4" />
    <path
        android:pathData="M61,53 m-2.8,0 a2.8,2.8 0 1,1 5.6,0 a2.8,2.8 0 1,1 -5.6,0"
        android:fillColor="#0A7C4F" />

    <!-- Two antennae. One reads as an aerial; two read as a snail. -->
    <path
        android:pathData="M30,60 L26,50"
        android:strokeColor="#0A7C4F"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <path
        android:pathData="M26,50 m-2.4,0 a2.4,2.4 0 1,1 4.8,0 a2.4,2.4 0 1,1 -4.8,0"
        android:fillColor="#0A7C4F" />
    <path
        android:pathData="M33,59 L32,48"
        android:strokeColor="#0A7C4F"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M32,48 m-2.2,0 a2.2,2.2 0 1,1 4.4,0 a2.2,2.2 0 1,1 -4.4,0"
        android:fillColor="#0A7C4F" />
</vector>
