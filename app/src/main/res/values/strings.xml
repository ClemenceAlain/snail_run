<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">snail run</string>

    <!-- Recording notification -->
    <string name="notification_channel_name">Recording a run</string>
    <string name="notification_channel_description">Shows your distance and pace while a run is being recorded.</string>
    <string name="notification_title">snail run</string>
    <string name="notification_starting">Waiting for GPS…</string>
    <string name="notification_progress">%1$s km · %2$s · %3$s /km</string>
    <string name="notification_workout_rep">%1$s %2$d/%3$d</string>

    <!-- Spoken announcements. Digits are fine; a colon is not. -->
    <plurals name="speech_kilometres">
        <item quantity="one">%1$s kilometre</item>
        <item quantity="other">%1$s kilometres</item>
    </plurals>
    <plurals name="speech_minutes">
        <item quantity="one">%1$d minute</item>
        <item quantity="other">%1$d minutes</item>
    </plurals>
    <plurals name="speech_seconds">
        <item quantity="one">%1$d second</item>
        <item quantity="other">%1$d seconds</item>
    </plurals>
    <plurals name="speech_hours">
        <item quantity="one">%1$d hour</item>
        <item quantity="other">%1$d hours</item>
    </plurals>
    <string name="speech_time">time</string>
    <string name="speech_average_pace">average pace</string>
    <string name="speech_last_split">last kilometre</string>
    <string name="speech_per_kilometre">per kilometre</string>
    <!-- Said when the app stops or starts the clock on the runner's behalf. Short: it
         interrupts nothing, and the runner is standing at a light wanting one word. -->
    <string name="speech_auto_paused">paused</string>
    <string name="speech_auto_resumed">running again</string>
    <!-- Counting a runner through a session. Said mid-rep at 170 beats a minute, so
         every one of these is as short as it can be and still mean something. -->
    <string name="speech_rep_of">rep %1$d of %2$d</string>
    <string name="speech_countdown">%1$d</string>
    <string name="speech_ease_down">ease down</string>
    <string name="speech_pick_it_up">pick it up</string>
    <string name="speech_session_complete">session done</string>
    <string name="speech_for">for</string>
    <string name="speech_between">between</string>
    <string name="speech_and">and</string>
    <string name="speech_next">then</string>
    <!-- Counting somebody through a session on the floor. Said while they are standing
         up off a mat rather than mid-rep, so these can afford whole words. -->
    <string name="speech_set_of">set %1$d of %2$d</string>
    <plurals name="speech_times">
        <item quantity="one">%1$d time</item>
        <item quantity="other">%1$d times</item>
    </plurals>
    <string name="speech_per_side">each side</string>
    <string name="speech_rest">rest</string>
</resources>
